{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Private Pilot",
  "version": "0.1.0",
  "identifier": "com.privatepilot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Private Pilot",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "backgroundColor": "#0B0C0E"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
